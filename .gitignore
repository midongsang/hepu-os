# ============================================================
# HepuOS 仓库 .gitignore
# ============================================================

# ---- 构建输出目录 ----
build_x86_64/
build_v250/
user/build/
user/rust/target/

# ---- 通用构建产物 ----
*.o
*.obj
*.elf
*.bin
*.img
*.iso
*.a
*.so
*.so.*
*.hex

# ---- 二进制运行时（Tier 1 迁出，tools/prepare_binaries.sh 拉取）----
# glibc 动态链接运行时（宿主 glibc 提供，make_single_img64.sh 自动 fallback）
user/apps/dynhello/ld-linux-x86-64.so.2
user/apps/dynhello/libc.so.6

# Secure Boot 密钥（安全敏感，部署前本地 generate_keys.sh 生成）
tools/hepboot/uefi/secureboot/*.key
tools/hepboot/uefi/secureboot/*.crt
tools/hepboot/uefi/secureboot/*.auth
tools/hepboot/uefi/secureboot/*.esl
tools/hepboot/uefi/secureboot/*.csr

# QEMU UEFI 固件（EDK2 官方发布，~11MB，从 OVMF 仓库下载）
tools/datadir/OVMF_CODE.fd
tools/datadir/OVMF_CODE_4M.fd
tools/datadir/OVMF_VARS.fd
tools/datadir/OVMF_VARS_4M.fd

# Shim 引导器（外部二进制，Fedora shim 项目）
tools/hepboot/uefi/shim/shimx64.efi
tools/hepboot/uefi/shim/mmx64.efi
tools/hepboot/uefi/shim/fbx64.efi

# Hepboot UEFI 引导器（构建产物，由 hepboot_gop.c + jump_kernel_64.S 编译）
tools/hepboot/uefi/hepboot_uefi.efi

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- 编辑器/IDE ----
.vscode/
.idea/
.trae/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- 调试/日志 ----
debug/
*.log
*.dmp
*.core

# ---- Rust 构建缓存 ----
CACHEDIR.TAG

# ---- 临时文件 ----
*.bak
*.orig
*.tmp

# ---- QEMU 运行产物（本地测试生成） ----
*.qcow2
*.raw
mon.sock
qmp.sock
serial.log

# ---- 本地安装的 QEMU 二进制（~60MB，由用户自行安装） ----
tools/bin/
tools/qemu_libs/

# ---- Trae 生成的 HTML 运行时报告（本地工具输出） ----
hepu-kernel-runtime/
hepu-os-runtime-report/

# ---- PPM / splash 截图（保留 splash_v3_*.ppm 启动画面源文件） ----
*.ppm
!splash_v3_*.ppm

# ---- Windows PE 测试程序（示例用，主机 gcc 产出） ----
winargs.exe
winhello.exe
