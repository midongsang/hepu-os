/* ============================================================================
 * 赫普OS - 极简 Multiboot 引导器 (GAS / AT&T)
 * 由赫普OS内核工程自研，不依赖GRUB/SYSLINUX等外部引导器
 *
 * 双变体（通过 -DISOBoot 区分）：
 *   - ISO变体：El Torito No-Emulation 引导映像，INT13 AH=42 块=2048字节
 *   - HDD变体：MBR stage2，INT13 AH=42 块=512字节
 *
 * 统一基址 0x7C00（由链接脚本 bootloader.ld 固定）
 * 功能：读取内核到 0x100000 → 收集E820 → 构造Multiboot info
 *       → 开A20 → 进保护模式 → 跳转内核 (_start)
 * ========================================================================== */

/* ---------- 编译期配置（可由-D覆盖） ---------- */
#ifdef ISOBoot
#ifndef KERNEL_LBA
#define KERNEL_LBA      21          /* ISO布局：内核起始LBA(2048字节块) */
#endif
#ifndef KERNEL_SECTORS
#define KERNEL_SECTORS  214         /* 内核占用块数 */
#endif
#define SECTOR_SHIFT    11          /* 每块字节数: 2048 */
#else
#ifndef KERNEL_LBA
#define KERNEL_LBA      5           /* HDD布局：内核起始LBA(512字节块, stage2占LBA1-4) */
#endif
#ifndef KERNEL_SECTORS
#define KERNEL_SECTORS  848         /* 内核占用块数 */
#endif
#define SECTOR_SHIFT    9           /* 每块字节数: 512 */
#endif

#define KERNEL_LOAD_ADDR 0x00100000  /* 内核加载物理地址 */
#define DAP_BUFFER       0x00007B00  /* 磁盘地址包缓冲区 */
#define E820_BUFFER      0x00009000  /* E820临时缓冲(24字节条目) V4.59-E104 */
#define MMAP_BUFFER      0x00009400  /* Multiboot mmap 区 (原0x9200在E820范围内!) */
#define GDT_ADDR         0x00009800  /* GDT(264字节, 33描述符). V4.99扩大, 索引32@0x9900. 避开MBINFO(0x9700) */
#define GDTR_ADDR        0x00009908  /* GDTR 伪描述符(GDT之后) */
#define RM16_STUB_ADDR   0x00001000  /* 清PE+IRET低地址桩代码区 */
#define MBINFO_ADDR      0x00009700  /* Multiboot info 结构 */
#define STACK_ADDR       0x00008F00  /* 保护模式栈顶(向下增长) 原0x8800覆盖stage2! */

#define MB_BOOT_MAGIC    0x2BADB002  /* 引导器返回给内核的magic(Multiboot boot magic) */
#define MB_HEADER_MAGIC  0x1BADB002  /* 内核Multiboot头魔数(Multiboot header magic) */
                                     /* V2.02修复: 验证内核头必须用0x1BADB002.
                                        原误用MB_BOOT_MAGIC(0x2BADB002)比较[0x100000],
                                        内核头实为0x1BADB002→永远不匹配→永远走失败路径
                                        (1声+长停)→误导排错, 且无法验证A20/内核加载 */

/* ---------- 代码 ---------- */
    .code16
    .section .text
    .globl _start
_start:
    cli
    /* 初始化段寄存器 (DS=ES=SS=0) */
    xorw %ax, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %ss
    movw $0x7000, %sp
    movb %dl, boot_drive        /* 保存引导驱动器号 */

#ifdef DEBUG_BOOT
    /* 诊断版: 强制设置80x25彩色文本模式(INT10 AH=0 AL=3)
       保证VGA文本模式, 使0xB8000直写必然有效 */
    movw $0x0003, %ax
    int $0x10
    /* 清屏 */
    movw $0xB800, %ax
    movw %ax, %es
    xorw %di, %di
    movw $2000, %cx
    movw $0x0720, %ax
    rep stosw
#endif
    movw $0, vga_row
    movw $0, vga_col

    /* 显示启动信息 (VGA直写) */
    movw $msg_boot, %si
    call print_str
    /* 状态标记 G(加载GDT) */
    movw $msg_gdt, %si
    call print_str
    /* 状态标记 A(启用A20) */
    movw $msg_a20, %si
    call print_str
    /* 状态标记 R(开始读盘) */
    movw $msg_reading, %si
    call print_str

    /* ---- 读取内核到 0x100000 ---- */
    call read_kernel
    testb %al, %al
    jnz 1f
    cli
    hlt
1:
    /* V5.13: 跳过print_str(可能vga_row异常导致越界写), 直接进collect_e820 */
#ifdef DEBUG_BOOT
    /* 诊断模式: 打印内核块数并延时(V4.94c: print_hex8已修复) */
    movw $msg_blocks, %si
    call print_str
    movl $KERNEL_SECTORS, %eax
    call print_dec32
    movw $msg_crlf, %si
    call print_str
    call delay
#endif
    /* ---- V2.09 重入入口修复(关键!) ----
       根因: MBR读stage2到0x7C00覆盖自身, INT13返回后CPU从stage2中部
       (0x7C5A, 即打印换行处)进入, 跳过了开头的call read_kernel(0x7C36)
       → 内核从未加载到0x100000 → 进保护模式跳转空内存 → 执行垃圾
       → 三重故障 → 黑屏回BIOS. 这正是真机"GD OK后黑屏"且无K0日志的根因.
       修复: 在collect_e820前检测0x20000内核头魔数, 未加载则补调read_kernel.
       正常从0x7C00进入时read_kernel已执行, 魔数存在→跳过, 不重复读盘.
       从0x7C5A进入时魔数不存在→补读, 保证跳转内核前0x100000有真实内核. */
    /* V5.12: 跳过魔数检测(第一次读盘已确认成功) */
    /* V5.12诊断: 标记'E'=执行到collect_e820前 */
    movw $0xB800, %ax
    movw %ax, %es
    movw $('E' | 0x0F00), %es:160*0+2*12
    xorw %ax, %ax
    movw %ax, %es
    /* ---- 收集E820内存映射 ---- */
    call collect_e820
#ifdef DEBUG_BOOT
    /* V2.06: E820 map_count显示移除, 腾空间给保护模式VGA标记(行8 K!).
       内存检测结果由内核multiboot_init消费, 此处不再显示 */
#endif
    /* ---- 构造Multiboot info ---- */
    call build_mbinfo

    /* ---- 开A20线: 组合方法(BIOS最可靠 + Fast A20兜底) ----
       V2.01修复: 原仅用port 0x92(Fast A20), 现代笔记本芯片组常失效;
       A20关闭时CPU访问1MB以上(内核0x101000)会回绕到0x00000执行垃圾→崩.
       先试BIOS INT15 AX=0x2401(返回CF=0即成功), 再无条件Fast A20双保险 */
    movw $0x2401, %ax
    int $0x15
    inb $0x92, %al
    orb $0x02, %al
    outb %al, $0x92

#ifdef DEBUG_BOOT
    /* 诊断模式: 打印跳转信息 */
    movw $msg_jump, %si
    call print_str
    /* 关键: 跳内核前等待按键, 避免诊断信息一闪而过
       用户看完按任意键(INT16 AH=0阻塞)才继续引导 */
    movw $msg_presskey, %si
    call print_str
    /* V2.12: 去掉INT16阻塞等待(QEMU无键盘输入→SeaBIOS等待卡死).
       改延时自动继续, 诊断信息仍可读; 真机同样自动. */
    call delay
    call delay
#endif
    /* 状态标记 P(进保护模式) */
    movw $msg_prot, %si
    call print_str
    /* V5.10诊断: 标记'J'=执行到enter_protected调用前 */
    movw $0xB800, %ax
    movw %ax, %es
    movw $('J' | 0x0F00), %es:160*0+2*10
    xorw %ax, %ax
    movw %ax, %es
    /* ---- 进入保护模式并跳转内核 ---- */
    call enter_protected

halt_loop:
    cli
    hlt
    jmp halt_loop

/* ==========================================================================
 * print_str: 直接写VGA显存(0xB8000)打印字符串, 不依赖INT10
 * 入参: DS:SI
 * ========================================================================== */
print_str:
    pusha
    push %es
    movw $0xB800, %ax
    movw %ax, %es
1:
    lodsb
    testb %al, %al
    jz 2f
    cmpb $'\n', %al
    je 3f
    cmpb $'\r', %al
    je 1b
    /* 先保存字符(避免计算偏移覆盖%al) */
    movb %al, %cl
    /* 计算显存偏移: (row*80+col)*2 */
    movzbl vga_col, %edx
    movzbl vga_row, %eax
    imull $80, %eax, %eax
    addl %edx, %eax
    shll $1, %eax
    movl %eax, %edi
    movb $0x07, %ch          /* 白字黑底 */
    movw %cx, %es:(%edi)
    incb vga_col
    cmpb $80, vga_col
    jb 1b
    movb $0, vga_col
    incb vga_row
    jmp 1b
3:
    movb $0, vga_col
    incb vga_row
    jmp 1b
2:
    pop %es
    popa
    ret

/* ==========================================================================
 * print_hex8: 打印AL的两位hex (实模式VGA直写)
 * 入参: AL
 * ========================================================================== */
print_hex8:
    pusha
    push %es
    movw $0xB800, %dx
    movw %dx, %es
    /* V4.94c修复: 原movb %al,%ah后依赖AH跨hex_digit调用保持,
       但hex_digit内部用EAX计算VGA偏移(movzbl vga_row,%eax等)
       →AH被破坏→低4位打印错误(实测0x12→"10", 0xC6→"C0").
       改用CL保存原值(hex_digit不碰ECX), 两次调用间恢复AH. */
    movb %al, %cl
    movb %cl, %ah
    /* 高4位 */
    movb %ah, %dl
    shrb $4, %dl
    call hex_digit
    /* 低4位 */
    movb %cl, %ah
    movb %ah, %dl
    andb $0x0F, %dl
    call hex_digit
    pop %es
    popa
    ret
hex_digit:
    cmpb $10, %dl
    jb 1f
    addb $('A' - '0' - 10), %dl
1:
    addb $'0', %dl
    movzbl vga_col, %edi
    movzbl vga_row, %eax
    imull $80, %eax, %eax
    addl %edi, %eax
    shll $1, %eax
    movb %dl, %es:(%eax)
    movb $0x07, %es:1(%eax)
    incb vga_col
    cmpb $80, vga_col
    jb 2f
    movb $0, vga_col
    incb vga_row
2:
    ret

/* ==========================================================================
 * print_hex16: 打印AX的四位hex
 * 入参: AX
 * ========================================================================== */
print_hex16:
    push %eax
    movb %ah, %al
    call print_hex8
    pop %eax
    push %eax
    movb %al, %ah
    /* V4.94c: 删冗余movb %al,%al(无操作), 省2字节stage2空间 */
    call print_hex8
    pop %eax
    ret

/* ==========================================================================
 * nibble_to_char: AL的低4位转hex字符
 * 入参: AL (低4位)
 * 出参: AL (hex字符)
 * ========================================================================== */
nibble_to_char:
    andb $0x0F, %al
    cmpb $10, %al
    jb 1f
    addb $('A' - '0' - 10), %al
1:
    addb $'0', %al
    ret

/* ==========================================================================
 * print_dec32: 打印32位无符号十进制 (INT10)
 * 入参: EAX
 * ========================================================================== */
print_dec32:
    /* 打印32位无符号十进制到VGA显存。EBP=除数, EDI=被除数。 */
    pusha
    push %es
    movl %eax, %edi          /* V4.94d: 必须先保存被除数! 原代码先movw $0xB800,%ax会覆盖AX */
    movw $0xB800, %ax
    movw %ax, %es
    movl $1000000000, %ebp   /* 除数(从10^9到1) */
    xorl %ecx, %ecx          /* 前导零标志 */
1:
    movl %edi, %eax
    xorl %edx, %edx
    divl %ebp                /* EAX=商(当前位), EDX=余数 */
    movl %edx, %ebx          /* V4.94d: 余数存EBX(所有路径都执行, 前导零跳过路径也需更新) */
    testl %eax, %eax
    jnz 2f
    testl %ecx, %ecx
    jnz 2f
    cmpl $1, %ebp            /* 个位必须打印 */
    je 2f
    jmp 3f
2:
    movb $1, %cl             /* V4.94d: 原movl $1,%ecx(6B)精简为movb(2B), ECX已在入口xor清零 */
    addb $'0', %al
    pushl %eax
    /* 写显存 */
    movzbl vga_col, %edx
    movzbl vga_row, %eax
    imull $80, %eax, %eax
    addl %edx, %eax
    shll $1, %eax
    movl %eax, %edi
    popl %eax
    movb %al, %cl
    movb $0x07, %ch
    movw %cx, %es:(%edi)
    incb vga_col
    cmpb $80, vga_col
    jb 3f
    movb $0, vga_col
    incb vga_row
3:
    movl %ebx, %edi          /* V4.94d: 新被除数=余数(EBX保存), 原用%edx已被vga_col覆盖 */
    movl %ebp, %eax
    xorl %edx, %edx          /* 高32位清零: 除数不能放edx(edx既是被除数高位又当除数→必然溢出#DE) */
    movl $10, %esi           /* 除数10放esi: 不碰ecx(前导零标志)不碰edx(高位) */
    divl %esi                /* 0:EAX / 10 → EAX商, EDX余 */
    movl %eax, %ebp
    testl %ebp, %ebp
    jnz 1b
    pop %es
    popa
    ret

/* ==========================================================================
 * delay: 实模式延时(约0.3-0.5秒), 让调试文字可读
 * ========================================================================== */
delay:
    pusha
    movl $600000, %ecx
1:
    decl %ecx
    jnz 1b
    popa
    ret

/* ==========================================================================
 * read_slice: 分块读内核到低地址缓冲 (实模式段:偏移可表达, <1MB)
 * 入参: EBP=起始LBA, ECX=块数, EDI=目标缓冲地址
 * 每次最多16块(HDD)/32块(ISO), 防BIOS静默截断.
 * V3.82分段: 内核673KB>低区缓冲576KB(0x10000-0xA0000), 读两段:
 *   段1(SEG1_SEC块)读0x10000→保护模式搬0x100000→回实模式读段2→再搬.
 * 返回: AL=1 成功, AL=0 失败
 * ========================================================================== */
/* V3.82分段宏: 段1=低区缓冲上限(576KB)/块大小; 段2=剩余; 段2搬移目标=0x100000+段1字节 */
#if (KERNEL_SECTORS) < ((0x00090000) >> SECTOR_SHIFT)
#define SEG1_SEC   (KERNEL_SECTORS)
#else
#define SEG1_SEC   ((0x00090000) >> SECTOR_SHIFT)
#endif
#define SEG2_SEC   ((KERNEL_SECTORS) - (SEG1_SEC))
#define SEG2_LBA   ((KERNEL_LBA) + (SEG1_SEC))
#define SEG2_DEST  (0x00100000 + ((SEG1_SEC) << SECTOR_SHIFT))

read_kernel:
    /* 读段1: 低区缓冲0x10000起, 最多576KB(0x10000+576KB=0xA0000=VGA起点, 安全) */
    movl $0x00010000, %edi      /* 缓冲基址 */
    movl $SEG1_SEC, %ecx        /* 段1块数 */
    movl $KERNEL_LBA, %ebp      /* 段1起始LBA */
    /* V4.94e回退: call read_slice会使SEG2配置可达, 但(1)SeaBIOS检测磁盘仅2016扇区,
       SEG2的LBA 1157-2250越界(AH=01); (2)当前架构是"全读完再搬", SEG2覆盖0x10000
       缓冲后保护模式搬移源数据已错. 正确架构需"读一段→搬一段→回实模式读下一段"
       (源码注释375行已写明), 或改用INT13 AH=42 LBA扩展直接读高位内存.
       V5.16: call+ret正常栈帧 + INT13独立栈. */
    call read_slice
    ret

read_seg2:
    /* 读段2: 内核剩余部分(段1搬移后复用0x10000缓冲) */
    movl $0x00010000, %edi
    movl $SEG2_SEC, %ecx
    movl $SEG2_LBA, %ebp
    call read_slice              /* V5.16: call */
    ret

read_slice:
    /* V5.04: 使用INT13 AH=42 LBA扩展读盘(不修改CX, SeaBIOS LBA路径更稳定).
       DAP在.bss段(dap_packet), DS=0时SI=偏移即可.
       V5.16: call+ret正常栈帧 + INT13独立栈(防BIOS栈覆盖pushal数据). */
    pushal
    cli
    /* 初始化DAP: size=16, sectors=1(每次读1扇区) */
    movb $0x10, dap_packet
    movw $1, dap_sectors
    testl %ecx, %ecx
    jz 2f
3:
    cli
    /* 设置DAP缓冲区地址: segment=EDI>>4, offset=EDI&0xFFFF */
    movl %edi, %eax
    movw %ax, dap_offset
    shrl $4, %eax
    movw %ax, dap_segment
    /* 设置DAP LBA(64位): 低32位=EBP, 高32位=0 */
    movl %ebp, dap_lba
    movl $0, dap_lba+4
    /* DS:SI = dap_packet (DS=0, SI=偏移) */
    xorw %ax, %ax
    movw %ax, %ds
    movw $dap_packet, %si
    /* 设置驱动器号和功能号 */
    movb boot_drive, %dl
    orb $0x80, %dl
    movb $0x42, %ah
    /* V5.03: 全寄存器保护(INT13 BIOS可能破坏EBP/EDI/ECX) */
    pushl %ecx
    pushl %ebp
    pushl %edi
    pushl %ebx              /* V5.17: 保护EBX(INT13可能修改EBX致subl不递减) */
    /* V5.15: 切换到独立栈0x6000 */
    movw %sp, %bp
    movw $0x6000, %sp
    int $0x13
    movw %bp, %sp           /* 切回原栈 */
    pushfw                  /* 保存FLAGS(含CF) */
    popw %ax
    popl %ebx
    popl %edi
    popl %ebp
    popl %ecx
    testw $1, %ax           /* 检查CF */
    jnz read_fail
    cli
    movl $1, %ebx
    addl %ebx, %ebp
    movl %ebx, %eax
    shll $9, %eax
    addl %eax, %edi
    subl %ebx, %ecx
    jmp 3b
2:
    sti                      /* V5.00: 恢复中断 */
    popal
    movb $1, %al
    ret
read_fail:
    /* 详细错误显示:
       Line1: E AH=xx D=xx LBA=xxxx
       Line2: C=xx H=xx S=xx
       Line3: BUF=xxxxxxxx REM=xxxx
    */
    pushw %es
    movw $0xB800, %bx
    movw %bx, %es
    movb $1, vga_row
    movb $0, vga_col
    /* Line1: E AH=xx D=xx LBA=xxxx */
    movw $msg_err_ah, %si
    call print_str
    movb %ah, %al
    call print_hex8
    movw $msg_err_dl, %si
    call print_str
    movb %dl, %al
    call print_hex8
    movw $msg_err_lba, %si
    call print_str
    movl %ebp, %eax
    call print_hex16
    /* Line2: C=xx H=xx S=xx */
    movw $msg_err_c, %si
    call print_str
    movb %ch, %al
    call print_hex8
    movw $msg_err_h, %si
    call print_str
    movb %dh, %al
    call print_hex8
    movw $msg_err_s, %si
    call print_str
    movb %cl, %al
    call print_hex8
    /* Line3: BUF=xxxxxxxx REM=xxxx */
    movw $msg_err_buf, %si
    call print_str
    movl %edi, %eax
    call print_hex16
    movw $msg_err_rem, %si
    call print_str
    movl %ecx, %eax
    call print_hex16
    popw %es
    cli
    hlt

read_done:
    movw $1, %ax
read_ret:
    movb %al, read_retval
    popa
    movb read_retval, %al
    ret

read_retval:
    .byte 0

/* V4.66: 读盘重试计数器 */
retry_count:
    .word 3

/* ==========================================================================
 * collect_e820: 收集内存映射，转Multiboot mmap条目存MMAP_BUFFER
 * 同时计算mem_upper(KB)
 * ========================================================================== */
collect_e820:
    pusha
    /* 修复: read_kernel污染了ES(读内核时设为内核段), 必须重置ES=0 */
    xorw %ax, %ax
    movw %ax, %es
    xorl %ebx, %ebx
    movw $0, map_count
    movl $0, mem_upper
e820_loop:
    /* 修复: 每次循环必须重置E820缓冲地址(上次迭代被mmap转换改掉) */
    movl $E820_BUFFER, %edi
    movl $0x534D4150, %edx   /* 'SMAP' */
    movl $24, %ecx
    movl $0xE820, %eax       /* 修复: 必须完整设置EAX=0xE820, 不能只movb %ah(AL残留致BIOS异常) */
    int $0x15
    jc e820_done
    cmpl $0x534D4150, %eax
    jne e820_done

    /* 转成20字节multiboot条目存MMAP_BUFFER */
    movl $map_count, %eax
    movl $20, %ebp
    mull %ebp
    movl $MMAP_BUFFER, %edi
    addl %eax, %edi
    movl $20, %ecx
    movw %cx, %es:(%edi)          /* size=20 */
    /* 修复: 用SI指向E820缓冲(0x8200), 之前误用未初始化的SI */
    movl $E820_BUFFER, %esi
    movl %es:0(%esi), %eax
    movl %eax, %es:4(%edi)        /* base low */
    movl %es:4(%esi), %eax
    movl %eax, %es:8(%edi)        /* base high */
    movl %es:8(%esi), %eax
    movl %eax, %es:12(%edi)       /* length low */
    movl %es:12(%esi), %eax
    movl %eax, %es:16(%edi)       /* length high */
    movl %es:16(%esi), %eax
    movl %eax, %es:20(%edi)       /* type */

    /* mem_upper: type=1且base>=1MB的最大结束地址(KB) */
    cmpl $1, %es:16(%esi)
    jne e820_next
    cmpl $0x00100000, %es:0(%esi)
    jb e820_next
    movl %es:0(%esi), %eax
    addl %es:8(%esi), %eax
    shrl $10, %eax
    cmpl mem_upper, %eax
    jbe e820_next
    movl %eax, mem_upper
e820_next:
    incw map_count
    cmpl $32, map_count
    jae e820_done            /* 保护: 最多32条, 防覆盖GDT区 */
    cmpl $0, %ebx
    jne e820_loop
e820_done:
    /* 兜底: 若E820未给出1MB以上内存(mem_upper=0),
       先用INT15 AX=E801(支持大内存), 失败再用AH=88 */
    cmpl $0, mem_upper
    jne e820_ret
    /* E801: 返回 AX=1-16MB(KB), BX=16MB以上(64KB块) */
    xorw %bx, %bx
    movw $0xE801, %ax
    int $0x15
    jc e801_fail
    movzwl %ax, %eax
    movzwl %bx, %edx
    shll $6, %edx
    addl %edx, %eax
    testl %eax, %eax
    jz e801_fail
    movl %eax, mem_upper
    jmp e820_ret
e801_fail:
    movb $0x88, %ah
    int $0x15
    jc e820_ret
    movzwl %ax, %eax
    testl %eax, %eax
    jz e820_ret
    movl %eax, mem_upper
e820_ret:
    popa
    ret

map_count:
    .word 0
mem_upper:
    .long 0

/* ==========================================================================
 * build_mbinfo: 构造Multiboot info (0x8F00)
 * flags: bit0(mem)+bit6(mmap)=0x41
 * ========================================================================== */
build_mbinfo:
    pusha
    /* 修复: 重置ES=0 (write到0x8F00必须ES=0) */
    xorw %ax, %ax
    movw %ax, %es
    movl $MBINFO_ADDR, %edi
    movl $0x41, %es:0(%edi)        /* flags */
    movl $640, %es:4(%edi)         /* mem_lower */
    movl mem_upper, %eax
    movl %eax, %es:8(%edi)         /* mem_upper */
    movl $0, %es:12(%edi)          /* boot_device */
    movl $0, %es:16(%edi)          /* cmdline */
    movl $0, %es:20(%edi)          /* mods_count */
    movl $0, %es:24(%edi)          /* mods_addr */
    movl $0, %es:28(%edi)          /* syms[0..3] */
    movl $0, %es:32(%edi)
    movl $0, %es:36(%edi)
    movl $0, %es:40(%edi)
    movw map_count, %ax
    movw %ax, %cx
    movl $20, %ebp
    mull %ebp
    movl %eax, %es:44(%edi)        /* mmap_length */
    movl $MMAP_BUFFER, %eax
    movl %eax, %es:48(%edi)        /* mmap_addr */
    popa
    ret

/* ==========================================================================
 * enter_protected: 写GDT、进保护模式、跳内核
 * ========================================================================== */
enter_protected:
    pusha
    xorw %ax, %ax
    movw %ax, %ds
    movw %ax, %es
    popa
#ifdef DEBUG_BOOT
    /* 诊断G0: 进入保护模式设置(段寄存器已重置) */
    movw $msg_g0, %si
    call print_str
#endif
    /* 写GDT到GDT_ADDR (33个描述符, 264字节), ES=0.
       V4.99: 删除code16描述符(索引3,不再使用), 添加rm16_stub描述符
       (索引32, 选择器0x0100, base=0x1000, D=0).
       选择器<<4=0x1000=base, 清PE后QEMU TCG重置CS.base为CS<<4时与保护模式base一致,
       取指地址=0x1000+EIP=物理地址. 清PE桩代码复制到0x1000执行. */
    movl $GDT_ADDR, %edi
    /* null (索引0) */
    movl $0, %es:(%edi)
    movl $0, %es:4(%edi)
    /* code32 (索引1, 选择器0x08): 0x00CF9A000000FFFF */
    movl $0x0000FFFF, %es:8(%edi)
    movl $0x00CF9A00, %es:12(%edi)
    /* data32 (索引2, 选择器0x10): 0x00CF92000000FFFF */
    movl $0x0000FFFF, %es:16(%edi)
    movl $0x00CF9200, %es:20(%edi)
    /* 索引3保留为NULL(原code16选择器0x18已废弃, V4.99改用0x0100低地址桩) */
    /* rm16_stub (索引32, 选择器0x0100): base=0x1000, D=0, limit=64K.
       低4字节=0x1000FFFF, 高4字节=0x009A0000 */
    movl $0x1000FFFF, %es:256(%edi)
    movl $0x009A0000, %es:260(%edi)
#ifdef DEBUG_BOOT
    /* 诊断G1: GDT写入完成 */
    movw $msg_g1, %si
    call print_str
#endif
    /* 写GDTR到GDTR_ADDR: limit=263(264字节-1), base=GDT_ADDR */
    movl $GDTR_ADDR, %esi
    movw $263, %ax
    movw %ax, %ds:(%esi)
    movl $GDT_ADDR, %eax
    movl %eax, %ds:2(%esi)
    lgdtw %ds:(%esi)
#ifdef DEBUG_BOOT
    /* 诊断G2: GDTR加载(lgdt)完成 */
    movw $msg_g2, %si
    call print_str
    /* 诊断G3: 进保护模式前按键确认, 让用户看到G0-G2诊断.
       此时仍是实模式(CR0.PE=0), INT16可用 */
    movw $msg_press_pm, %si
    call print_str
    /* V2.12: 同上, 去INT16阻塞, 延时自动继续 */
    call delay
    movw $msg_go_pm, %si
    call print_str
    /* V2.01诊断: 读回验证GDT[1]低16位(应为0xFFFF).
       G1只表示"写入指令执行过", 这里读回确认真机GDT内容真实写入,
       用于区分"GDT写入失败/被破坏" vs "CR0.PE/ljmp失败" */
    movw $0, %ax
    movw %ax, %ds
    movw %ds:GDT_ADDR+8, %ax
    cmpw $0xFFFF, %ax
    je 1f
    movw $msg_gd_bad, %si
    call print_str
    jmp 2f
1:  movw $msg_gd_ok, %si
    call print_str
2:
#endif
#ifdef DEBUG_BOOT
    /* V2.07: 实模式A20检测移除——A20已在V2.04确认开启(无A20OFF显示),
       保留检测无增量价值且占35B. A20状态改由保护模式+行8VGA标记+蜂鸣判定:
       A20关→P0(1)+P1(2)+a20_fail(2)+halt; A20开→P0(1)+P1(2)+P2(4声) */
#endif
    /* V2.01防御: 确保IF=0再进保护模式(BIOS的int $0x16可能sti, 且cli过的IF
       也应被显式确认; 保护模式无IDT, 任何中断=三重故障黑屏) */
    cli
    /* 进入保护模式: 先清零EAX再读CR0.
       关键修复: `mov %cr0,%eax`在16位模式只读低16位到AX, EAX高16位残留垃圾.
       部分CPU将`mov %eax,%cr0`按32位解析写完整CR0→垃圾bit31(PG)意外置1→
       无页表开启分页→立即#PF→无IDT→三重故障→黑屏回BIOS(真机实测P0不显示).
       xor清零后: 16位写只动低16位(PE), 32位写则高16位=0(PG=0), 两种都安全 */
    xorl %eax, %eax
    movl %cr0, %eax
    orl $1, %eax
    movl %eax, %cr0
    /* V2.01: 写CR0.PE后立即执行一条jmp flush指令预取队列(Intel推荐) */
    jmp 1f
1:
    /* 远跳转32位: 16位模式下EA指令=offset16+selector16.
       不能用 .long protected_mode(4字节), 否则CPU按16位读offset低2字节,
       selector读到offset高2字节=0x0000→GDT[0]null→#GP→三重故障黑屏.
       用GAS标准far jump, 由汇编器正确编码16位offset+selector */
    ljmp $0x0008, $protected_mode

    .code32
protected_mode:
    movw $0x10, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %fs
    movw %ax, %gs
    movw %ax, %ss
    movl $STACK_ADDR, %esp
#if 1   /* V4.99修复: 原#ifdef DEBUG_BOOT错误包裹了A20检测/搬移SEG1/回实模式读SEG2等核心代码,
           关掉DEBUG_BOOT后核心功能全部丢失→直接跳空内存. 改为#if 1确保核心代码始终编译.
           P0/P1/A2/P2等诊断标记也一并编译(占用少量空间, stage2有余量). */
    /* V2.08: 纯文本日志(彻底去蜂鸣) —— 保护模式每步写屏幕文本标签, 多行不覆盖.
       用户无需数蜂鸣次数, 直接看屏幕卡在哪:
         行8=P0(进保护模式) 行9=P1(段设置) 行10=A2/AF(A20)
         行11=P2/PF(内核校验) 行12=J>(跳内核)
       每步延时: P0/P1各~4秒让用户看清(同时验证保护模式VGA可见性),
       后续步骤快速推进. 若系统在某步崩溃, 崩溃前日志已显示+停留,
       用户能看到最后成功的步骤=定位卡点. */
    /* P0: 进保护模式+段设置成功 */
    movl $0xB8000+1280, %edi        /* 行8 */
    movw $('P' | 0x0F00), %es:(%edi)
    movw $('0' | 0x0F00), %es:2(%edi)
    movl $0xFFFF, %ecx          /* P0显示节奏延时(V4.64: QEMU下0x7FFFFF太慢,改短) */
1:  loop 1b
    /* P1: 准备A20检测 */
    movl $0xB8000+1440, %edi        /* 行9 */
    movw $('P' | 0x0F00), %es:(%edi)
    movw $('1' | 0x0F00), %es:2(%edi)
    movl $0xFFFF, %ecx          /* P1显示节奏延时 */
2:  loop 2b
    /* ---- A20检测: 写测试模式到0x000000/0x100000, 读回验证 ----
       A20关闭时CPU访问1MB以上回绕到0x00000(实模式Wrap-Around).
       检测: [0x000000]=0x12345678, [0x100000]=0x9ABCDEF0, 读[0x00000]:
         A20开→0x100000写入不影响0x00000, 读0x00000=0x12345678;
         A20关→0x100000写入回绕覆盖0x00000, 读0x00000=0x9ABCDEF0 */
    movl $0x12345678, 0x000000
    movl $0x9ABCDEF0, 0x100000
    cmpl $0x12345678, 0x000000
    je a20_ok                /* A20开: 0x00000未被覆盖 */
    /* A20关 → 0x92+0xEE开启 → 重新检测.
       去KBC(8042): 现代Dell无8042, inb $0x64等待循环死循环 */
    call enable_a20_pm
    cmpl $0x12345678, 0x000000
    jne a20_fail            /* 仍被覆盖 → A20关闭 */
a20_ok:
    /* A20开: 行10 "A2" */
    movl $0xB8000+1600, %edi
    movw $('A' | 0x0F00), %es:(%edi)
    movw $('2' | 0x0F00), %es:2(%edi)
    /* 搬移段1: 0x10000 → 0x100000 (rep movsl, DS=ES=0x10 flat base=0).
       内核673KB>低区缓冲576KB, 分段读盘: 段1搬移后回实模式读段2再搬. */
    movl $0x00010000, %esi
    movl $0x00100000, %edi
    movl $SEG1_SEC, %eax
    /* V2.13修复: dword数 = 块数*块大小/4 = 块数<<(SECTOR_SHIFT-2). */
    shll $(SECTOR_SHIFT-2), %eax /* dword数 = 块数*块大小/4 */
    movl %eax, %ecx
    cld
    rep movsl
#ifdef SEG2_SEC_DBG
    /* 无段2(内核<=576KB): 直接P2校验 */
#else
#if SEG2_SEC > 0
    /* ---- V3.84: 读段2(内核剩余部分)——回实模式 ----
       V3.82用 far jump(段0x07C0+相对偏移)回实模式, QEMU TCG下CS缓存
       D位不刷新→跳转后仍按32位解码→跳飞(偶发, 真机正常但模拟器不可靠).
       V3.84改 IRET 标准回实模式: 32位模式 push EIP:CS:EFLAGS:ESP:SS 帧,
       IRET由处理器强制按实模式刷新CS高速缓存(D=0, base=0, limit=64K),
       QEMU/真机均可靠. */
    /* V4.99: 回实模式(方案C: 低地址桩+直接ljmp).
       1. 将清PE+ljmp桩代码复制到0x1000
       2. ljmp到rm16_stub段(选择器0x0100, base=0x1000, D=0), EIP=0
       3. 桩代码清PE=0. 清PE后CS.base被QEMU TCG重置为0x0100<<4=0x1000,
          与保护模式base=0x1000一致, 取指地址=0x1000+EIP=物理地址(BUG-07修复)
       4. 桩代码中ljmp到实模式段0x0800:rm_read_seg2, 刷新CS */
    /* 复制桩代码到0x1000 (必须用32位寄存器, 保护模式下rep movsb用ESI/EDI/ECX) */
    movl $rm16_stub_code, %esi
    movl $RM16_STUB_ADDR, %edi
    movl $(rm16_stub_end - rm16_stub_code), %ecx
    rep movsb
    cli
    ljmp $0x0100, $0x0000

/* === 清PE+ljmp桩代码(运行时复制到0x1000执行) === */
.code16
rm16_stub_code:
    data32
    movl %cr0, %eax
    andb $0xFE, %al
    data32
    movl %eax, %cr0
    /* 清PE后CS.base=0x1000(=0x0100<<4), 取指地址正确. ljmp到实模式段 */
    ljmp $0x0800, $rm_read_seg2 - 0x8000
rm16_stub_end:
.code32

rm_read_seg2:
    /* DS/ES/SS保持保护模式0x10(base=0,limit=4GB), 实模式下可继续用, 无需重置 */
    movw $0x7000, %sp
    /* R1: 已回实模式 */
    movw $0xB800, %ax
    movw %ax, %es
    movw $0x820, %di
    movw $('R' | 0x0F00), %es:(%di)
    xorw %ax, %ax
    movw %ax, %es
    call read_seg2
    testb %al, %al
    jz halt_loop                /* 段2读失败→停机(复用实模式halt_loop) */
    /* R2: 段2读盘成功 */
    movw $0xB800, %ax
    movw %ax, %es
    movw $0x822, %di
    movw $('2' | 0x0F00), %es:(%di)
    xorw %ax, %ax
    movw %ax, %es
    /* 再进保护模式(GDTR保留, 无需重设GDT) */
    cli
    movl %cr0, %eax
    orl $1, %eax
    movl %eax, %cr0
    jmp 1f
1:
    /* V4.65修复: CR0.PE=0后CS缓存D位未刷新, CPU仍按32位解码→ljmp EA被读成
       offset32+selector16(7字节)而非offset16+selector16(5字节)→selector读错
       →CS=0x0002(LDT)→#GP→三重故障. 加0x66操作数大小前缀强制16位offset. */
    .byte 0x66
    ljmp $0x0008, $pm_read_seg2
    .code32
pm_read_seg2:
    movw $0x10, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %fs
    movw %ax, %gs
    movw %ax, %ss
    movl $STACK_ADDR, %esp
    /* R3: 已回保护模式. ES已=0x10(base=0), 直接写物理VGA 0xB8000+偏移 */
    movl $0xB8000 + 0x824, %edi
    movw $('3' | 0x0F00), %es:(%edi)
    /* 搬移段2: 0x10000 → SEG2_DEST */
    movl $0x00010000, %esi
    movl $SEG2_DEST, %edi
    movl $SEG2_SEC, %eax
    shll $(SECTOR_SHIFT-2), %eax
    movl %eax, %ecx
    cld
    rep movsl
    /* R4: 段2搬移完成. ES=0x10(base=0), 直接写物理VGA */
    movl $0xB8000 + 0x826, %edi
    movw $('4' | 0x0F00), %es:(%edi)
#endif
#endif
    /* P2: 搬移后验证内核头魔数(Multiboot header magic 0x1BADB002).
       A20已检测/修复, 此处失败=搬移/读盘问题 */
p2_check:
    movl $0x100000, %edi
    movl (%edi), %eax
    cmpl $MB_HEADER_MAGIC, %eax
    jne 3f
    /* P2通过: 行11 "P2" + 行12 "J>" */
    movl $0xB8000+1760, %edi
    movw $('P' | 0x0F00), %es:(%edi)
    movw $('2' | 0x0F00), %es:2(%edi)
    movl $0xB8000+1920, %edi
    movw $('J' | 0x0F00), %es:(%edi)
    movw $('>' | 0x0F00), %es:2(%edi)
    jmp 4f
3:
    /* P2校验失败: 行11 "PF" + halt */
    movl $0xB8000+1760, %edi
    movw $('P' | 0x0F00), %es:(%edi)
    movw $('F' | 0x0F00), %es:2(%edi)
    cli
    hlt
a20_fail:
    /* A20开启失败: 行10 "AF" + halt */
    movl $0xB8000+1600, %edi
    movw $('A' | 0x0F00), %es:(%edi)
    movw $('F' | 0x0F00), %es:2(%edi)
    cli
    hlt
4:
#endif
    /* Multiboot约定: EAX=magic, EBX=info地址 */
    movl $MB_BOOT_MAGIC, %eax
    movl $MBINFO_ADDR, %ebx
    /* 修复: 跳转内核真正的入口点_start(KERNEL_ENTRY),
       而不是文件开头的Multiboot头(数据非代码, 跳过去=垃圾指令→三重故障) */
    ljmp $0x08, $KERNEL_ENTRY


/* ==========================================================================
 * enable_a20_pm: 保护模式下开启A20线(端口I/O不受模式限制).
 * V2.02修复: 仅0x92 Fast A20 + 0xEE快速A20口.
 * 真机实测"3声后长时间停留GD OK"根因: 原含KBC(8042)使能序列, 现代Dell
 * 笔记本无8042键盘控制器(由EC/SMBus模拟), inb $0x64等待输入缓冲空的
 * 循环永远死循环→引导器卡死. 去掉KBC后:
 *   0x92/0xEE为现代Intel/AMD芯片组直接支持的A20切换口, 至少一个有效.
 * 入参: 无   出参: 无(破坏eax/eflags, 已pusha保护)
 * ========================================================================== */
enable_a20_pm:
    pusha
    /* ① Fast A20: port 0x92 bit1 */
    inb $0x92, %al
    orb $0x02, %al
    outb %al, $0x92
    /* ② 快速A20口: port 0xEE 写任意值(现代芯片组A20切换) */
    movb $0x01, %al
    outb %al, $0xEE
    popa
    ret

/* ========== 只读数据 ========== */
    .section .rodata
msg_boot:
    .asciz "H2"
msg_gdt:
    .asciz "G"
msg_a20:
    .asciz "A"
msg_reading:
    .asciz "R"
msg_readok:
    .asciz "K"
msg_move:
    .asciz "M"
msg_prot:
    .asciz "P"
/* 详细错误显示 */
msg_err_ah:
    .asciz "E AH="
msg_err_dl:
    .asciz " D="
msg_err_lba:
    .asciz " LBA="
msg_err_c:
    .asciz "\nC="
msg_err_h:
    .asciz " H="
msg_err_s:
    .asciz " S="
msg_err_buf:
    .asciz "\nBUF="
msg_err_rem:
    .asciz " REM="
#ifdef DEBUG_BOOT
msg_blocks:
    .asciz "b="
msg_crlf:
    .asciz "\n"
msg_jump:
    .asciz "H5"
msg_presskey:
    .asciz "K\n"
msg_g0:
    .asciz "G0\n"
msg_g1:
    .asciz "G1\n"
msg_g2:
    .asciz "G2\n"
msg_press_pm:
    .asciz "PM\n"
msg_go_pm:
    .asciz ">P\n"
msg_gd_ok:
    .asciz "GD OK\n"
msg_gd_bad:
    .asciz "GD BAD\n"
#endif

    .section .bss
boot_drive:
    .byte 0
vga_row:
    .byte 0
vga_col:
    .byte 0
/* V4.95: INT13 AH=42 LBA扩展磁盘地址包(DAP), 替换CHS以支持>2016扇区.
   size字段(0x10)在read_slice运行时设置, 故整体放.bss */
dap_packet:
    .byte 0                 /* DAP大小=16(运行时设置) */
    .byte 0                 /* 保留 */
dap_sectors:
    .word 0                 /* 要读的扇区数 */
dap_offset:
    .word 0                 /* 缓冲偏移 */
dap_segment:
    .word 0                 /* 缓冲段 */
dap_lba:
    .quad 0                 /* 64位LBA */
saved_ret_ip:
    .word 0                 /* V5.06: read_slice返回地址(BIOS可能破坏FS,改用内存) */
