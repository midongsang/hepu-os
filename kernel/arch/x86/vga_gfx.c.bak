void gfx_putchar(int x, int y, char c, uint8_t color)
{
    if (c < 32 || c > 126) c = '?';
    const uint8_t *glyph = font_8x8[c - 32];
    for (int row = 0; row < 8; row++) {
        uint8_t line = glyph[row];
        for (int col = 0; col < 8; col++) {
            if (line & (0x80 >> col)) {
                gfx_putpixel(x + col, y + row, color);
            }
        }
    }
}

void gfx_puts(int x, int y, const char *s, uint8_t color)
{
    int cx = x;
    while (*s) {
        if (*s == '\n') {
            y += 8;
            cx = x;
            s++;
            continue;
        }
        gfx_putchar(cx, y, *s, color);
        cx += 8;
        s++;
    }
}

/* V2.35: 放大 8x8 字体绘制字符 (scale=整数倍), 用于开机 logo 大字 */
void gfx_putchar_big(int x, int y, char c, uint8_t color, int scale)
{
    if (scale < 1) scale = 1;
    if (c < 32 || c > 126) c = '?';
    const uint8_t *glyph = font_8x8[c - 32];
    for (int row = 0; row < 8; row++) {
        uint8_t line = glyph[row];
        for (int col = 0; col < 8; col++) {
            if (line & (0x80 >> col)) {
                gfx_fillrect(x + col * scale, y + row * scale, scale, scale, color);
            }
        }
    }
}

void gfx_puts_big(int x, int y, const char *s, uint8_t color, int scale)
{
    int cx = x;
    while (*s) {
        if (*s == '\n') {
            y += 8 * scale;
            cx = x;
            s++;
            continue;
        }
        gfx_putchar_big(cx, y, *s, color, scale);
        cx += 8 * scale;
        s++;
    }
}
