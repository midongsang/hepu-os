# ============================================================
# [已废弃] GRUB安全模式方案已放弃
# 决策时间：2026-09-22
# 原因：集中精力做HepuBoot自恢复模式，不依赖外部引导器
# 替代方案：HepuBoot内置自恢复（三模式降级+引导菜单+失败自动恢复）
# 此文件保留仅作历史参考
# ============================================================

# ============================================================
# HepuBoot GRUB 安全模式配置
# 定位：Windows风格的安全模式/恢复模式
# - 当HepuBoot（自研引导）引导失败时，用GRUB引导进入系统
# - 提供多种显示模式选项，方便排查显示问题
# - 长期目标：HepuBoot功能完整后，GRUB仅作为恢复模式保留
# ============================================================

set timeout=5
set default=0

# 加载VBE模块（高分辨率支持）
if [ "$grub_platform" = "pc" ]; then
    insmod vbe
fi

# ============================================================
# 正常模式：高分辨率VBE（800x600x24）
# ============================================================
menuentry "HepuOS - 正常模式 (高分辨率)" {
    set gfxpayload=800x600x24
    multiboot /boot/hepu-kernel.bin
    boot
}

# ============================================================
# 安全模式：标准VGA分辨率（640x480），兼容性最好
# 类似Windows的安全模式，使用最基础的显示驱动
# ============================================================
menuentry "HepuOS - 安全模式 (标准VGA)" {
    set gfxpayload=640x480x16
    multiboot /boot/hepu-kernel.bin hepu.safe=1
    boot
}

# ============================================================
# 恢复模式：文本模式（80x25），最基础环境
# 用于系统严重故障时的恢复和调试
# ============================================================
menuentry "HepuOS - 恢复模式 (文本)" {
    set gfxpayload=text
    multiboot /boot/hepu-kernel.bin hepu.recovery=1
    boot
}

# ============================================================
# 内存测试
# ============================================================
menuentry "内存检测 (MemTest)" {
    multiboot /boot/hepu-kernel.bin hepu.memtest=1
    boot
}
